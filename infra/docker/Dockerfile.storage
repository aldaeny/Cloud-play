# Free official upstream source, exact commits/archive hashes, pinned Go compiler.
# These are Cloud Play source builds, NOT vendor-distributed official binaries.
FROM golang:1.27.4-bookworm AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
ARG TARGETARCH
RUN set -eu; case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac; \
    mkdir -p /src/minio /src/mc /source; \
    curl --fail --location --retry 3 https://codeload.github.com/minio/minio/tar.gz/9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a -o /source/minio.tar.gz; \
    echo '45521908307306e925c98d629e1c17d78c8b72b6ee242b1bfb1409f7d8ee5841  /source/minio.tar.gz' | sha256sum -c -; \
    curl --fail --location --retry 3 https://codeload.github.com/minio/mc/tar.gz/d6541ea280b73a834b64d4097e21f2be77676104 -o /source/mc.tar.gz; \
    echo '4cea8ed209c8f96e59ea1a5cc4901019b54c2be6d6f5f16c6749ea8bdcf4172e  /source/mc.tar.gz' | sha256sum -c -; \
    tar -xzf /source/minio.tar.gz -C /src/minio --strip-components=1; \
    tar -xzf /source/mc.tar.gz -C /src/mc --strip-components=1
WORKDIR /src/minio
RUN go mod download && go mod verify
RUN GOOS=linux GOARCH=$TARGETARCH go build -mod=readonly -buildvcs=false -trimpath -tags kqueue \
    -ldflags '-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z.cloudplay-source -X github.com/minio/minio/cmd.CommitID=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a' -o /minio .
WORKDIR /src/mc
RUN go mod download && go mod verify
RUN GOOS=linux GOARCH=$TARGETARCH go build -mod=readonly -buildvcs=false -trimpath \
    -ldflags '-s -w -X github.com/minio/mc/cmd.Version=2025-08-13T08:35:41Z -X github.com/minio/mc/cmd.ReleaseTag=RELEASE.2025-08-13T08-35-41Z.cloudplay-source -X github.com/minio/mc/cmd.CommitID=d6541ea280b73a834b64d4097e21f2be77676104' -o /mc .
FROM debian:bookworm-slim
ARG CLOUDPLAY_RELEASE
LABEL org.opencontainers.image.revision=$CLOUDPLAY_RELEASE
LABEL org.opencontainers.image.licenses=AGPL-3.0-only
LABEL org.opencontainers.image.source=https://github.com/minio/minio
LABEL org.opencontainers.image.description="Cloud Play source build; not an official vendor binary"
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /minio /usr/local/bin/minio
COPY --from=build /mc /usr/local/bin/mc
# Preserve exact upstream main source archives and build instructions in conveyed images.
# This is not legal sign-off that all corresponding dependency source obligations are met.
COPY --from=build /source /usr/share/doc/cloudplay-storage/source
COPY infra/docker/Dockerfile.storage /usr/share/doc/cloudplay-storage/Dockerfile.storage
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
