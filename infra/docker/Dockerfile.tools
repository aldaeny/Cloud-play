# Offline-at-runtime lifecycle image. CLI dependencies are intentionally retained.
FROM node:22-bookworm-slim
ARG CLOUDPLAY_RELEASE
LABEL org.opencontainers.image.revision=$CLOUDPLAY_RELEASE
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY . .
ENV PRISMA_REQUIRE_NATIVE=true
RUN npm ci --no-audit --no-fund && npm run prisma:generate --workspace aether-api
USER node
ENTRYPOINT ["node", "scripts/selfhost/database.cjs"]
