# ─────────────────────────────────────────────────────────────
# Aether / Cloud Play — Environment Variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://aether:replace-with-a-strong-password@postgres:5432/aether?schema=public"

# ── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="604800"

# ── Admin JWT ─────────────────────────────────────────────
ADMIN_JWT_SECRET="replace-with-another-long-random-string"

# ── Tenancy ───────────────────────────────────────────────
DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000000"

# ── Object Storage (MinIO / S3-compatible) ─────────────────
STORAGE_ENDPOINT="http://minio:9000"
STORAGE_BUCKET="cloudplay-video"
STORAGE_ACCESS_KEY="replace-access-key"
STORAGE_SECRET_KEY="replace-with-a-long-secret-key"
STORAGE_SECURE="false"

# ── Transcoding ────────────────────────────────────────────
FFMPEG_PATH="ffmpeg"

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# ── Ports ──────────────────────────────────────────────────
API_PORT="3000"
WEB_PORT="3001"
ADMIN_PORT="3002"
WORKER_PORT="3004"

# Docker: replace all credentials and URL-encode special characters in DATABASE_URL
POSTGRES_USER="aether"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="aether"
# Public endpoint must be reachable by the browser and match the signature host.
STORAGE_PUBLIC_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_IMAGE_BUCKET="cloudplay-images"
STORAGE_SUBTITLE_BUCKET="cloudplay-subtitles"
# Cloud Play Iraq is FREE. Free access is the default; the subscription gate is
# only re-enabled if an operator explicitly sets FREE_ACCESS=false.
# Rights windows and stream/device limits still apply in free mode.
FREE_ACCESS="true"
# No payment provider, CDN or DRM is integrated yet.
PAYMENT_PROVIDER="disabled"
CDN_DOMAIN=""
DRM_WIDEVINE_LICENSE_SERVER=""
DRM_FAIRPLAY_LICENSE_SERVER=""
DRM_FAIRPLAY_CERTIFICATE=""

# Local-only, read-only Xtream catalog. HTTP explicitly enabled at the user's request.
# HTTP transmits credentials in cleartext; credentials are blank until you set them.
# Do not publish or expose this environment; prefer HTTPS in production.
XTREAM_CATALOG_ENABLED="false"
XTREAM_BASE_URL="http://redchicks.xyz:2052"
XTREAM_ALLOW_HTTP="false"
XTREAM_USERNAME=""
XTREAM_PASSWORD=""

# PRIVATE owner-only player (/my-tv). Server-side only — never NEXT_PUBLIC.
# Comma-separated account emails allowed to open the private player. The public
# site lets anyone sign up, so "signed in" alone is NOT enough. Empty = deny all.
# Private access requires approved immutable Supabase Auth UUIDs, not emails.
XTREAM_OWNER_USER_IDS=""
# Legacy label only; this never grants access:
XTREAM_OWNER_EMAILS=""
# Key material for the encrypted playback tokens. Defaults to XTREAM_PASSWORD.
# Set a long random value so rotating the provider password is independent.
XTREAM_PROXY_SECRET=""

# Operator-curated playlist ONLY. The operator must verify rights for every stream.
# Never commit the real M3U file or put credentials / tokens in public stream URLs.
CLOUDPLAY_IPTV_RIGHTS_CONFIRMED=false
CLOUDPLAY_IPTV_FILE=

# Free accounts (Supabase Auth + Postgres/RLS). Both values are PUBLIC by design:
# the anon key only allows authenticated users to touch their own rows via RLS.
# Never put the service_role / secret key here or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Local design-only artwork; never enable for a public deployment.
NEXT_PUBLIC_DESIGN_PREVIEW=false
# Optional operator-provided M3U content for serverless deployment. Public URLs only.
CLOUDPLAY_IPTV_M3U=
# Optional separately licensed XMLTV guide. Choose file path OR XML text.
CLOUDPLAY_EPG_RIGHTS_CONFIRMED=false
CLOUDPLAY_EPG_FILE=
CLOUDPLAY_EPG_XML=

# External Manager: server-only, opt-in. Never enable in production without approval.
EXTERNAL_MONITOR_SCHEDULER_ENABLED=false
# Cleartext GET media only; URL query credentials are always forbidden over HTTP.
EXTERNAL_ALLOW_CLEARTEXT_MEDIA=false
# Absolute path to an operator-installed clamscan-compatible scanner.
# Empty/error/timeout => quarantine; previously uploaded evidence also needs scanning.
EXTERNAL_DOCUMENT_SCANNER_PATH=""
# Trusted edge signs user/tenant/channel/country/platform/expiry context.
# Independent of Supabase authentication; never put this key in browser/public env.
EXTERNAL_PLAYBACK_CONTEXT_KEY=""
# HTTPS, fixed operator-controlled recipient. Delivery ALSO needs per-tenant consent.
# Receiver must deduplicate the stable idempotencyKey form field (at-least-once delivery).
EXTERNAL_REPORT_WEBHOOK_URL=""
EXTERNAL_REPORT_WEBHOOK_SECRET=""

# Protected Live Phase 2 — SERVER ONLY. Defaults deny playback.
# Must exactly match the browser's HTTPS Origin, not a forwarded Host value.
EXTERNAL_PUBLIC_ORIGIN=""
# Shared only between Next and Nest; >=32 random bytes. Never NEXT_PUBLIC_*.
EXTERNAL_GEO_SIGNING_KEY=""
# Enable only on actual Vercel ingress (VERCEL=1). Never emulate this on a
# custom/public origin; unsigned arbitrary client country headers are not trusted.
EXTERNAL_TRUST_VERCEL_GEO=false
# Metadata IDs -> already approved backend channel UUIDs. Does not approve sources.
EXTERNAL_CHANNEL_BINDINGS="{}"
# Optional metadata ID -> "dash"; HLS is default. No DRM/encrypted HLS support.
EXTERNAL_CHANNEL_FORMATS="{}"
# Backend per-user cap, 1..10. Atomic across replicas using PostgreSQL.
EXTERNAL_PLAYBACK_CONCURRENT_LIMIT=2
# EXTERNAL_PLAYBACK_CONTEXT_KEY above is legacy verifier configuration; it no
# longer grants manifest access. A live Supabase-bound DB lease is mandatory.
# Approved backend-only housekeeping: mark expired leases revoked, retain history;
# prune at most 500 expired nonces per minute/DB lock. No provider network access.
EXTERNAL_PLAYBACK_CLEANUP_ENABLED=false
# Production validation requires API_END_USER_AUTHORITY=supabase and explicit
# DATABASE_URL query budgets: connection_limit=5&pool_timeout=10 (example only).
# Approve total replicas * per-replica pool + Auth/workers/headroom against the
# actual DB/pooler limit; these example values are NOT a capacity certification.
