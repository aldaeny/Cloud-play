{
  "$schema": "https://cloud-play.dev/schemas/ui-tokens.v2.json",
  "meta": {
    "name": "Cloud Play — Universal Liquid Glass",
    "version": "2.0.0",
    "description": "Single source of truth for Web, iOS, iPadOS, tvOS, Android and Android TV. Every value below generates CSS custom properties (web) and native constants (Swift / Kotlin). Run `npm run tokens` from the repository root after editing.",
    "generated": [
      "apps/web/src/styles/tokens.generated.css",
      "mobile/ios/Aether/DesignSystem/CloudPlayTokens.swift",
      "mobile/android/app/src/main/java/com/aether/android/designsystem/CloudPlayTokens.kt"
    ]
  },

  "color": {
    "dark": {
      "canvas":        "#05060A",
      "canvas-raised": "#0A0C12",
      "canvas-sunken": "#030409",
      "ambient-blue":  "#1F3A7A",
      "ambient-violet":"#40206F",
      "ambient-magenta":"#5A1236",

      "glass-1": "rgba(255, 255, 255, 0.055)",
      "glass-2": "rgba(255, 255, 255, 0.085)",
      "glass-3": "rgba(255, 255, 255, 0.125)",
      "glass-solid": "#14161E",
      "glass-rim": "rgba(255, 255, 255, 0.13)",
      "glass-rim-strong": "rgba(255, 255, 255, 0.26)",
      "glass-highlight": "rgba(255, 255, 255, 0.42)",
      "glass-shadow": "rgba(0, 0, 0, 0.55)",

      "text-primary":   "#F5F7FC",
      "text-secondary": "rgba(233, 238, 249, 0.72)",
      "text-tertiary":  "rgba(233, 238, 249, 0.48)",
      "text-on-accent": "#FFFFFF",

      "accent":         "#7AA2FF",
      "accent-strong":  "#9B7BFF",
      "accent-soft":    "rgba(122, 162, 255, 0.16)",
      "accent-magenta": "#FF5FA2",
      "success":        "#4ADE80",
      "warning":        "#FBBF24",
      "danger":         "#FB7185",
      "focus":          "#B9D2FF"
    },
    "light": {
      "canvas":        "#EEF1F7",
      "canvas-raised": "#F7F9FD",
      "canvas-sunken": "#E3E8F1",
      "ambient-blue":  "#C9DBFF",
      "ambient-violet":"#DCCBFF",
      "ambient-magenta":"#FFD3E6",

      "glass-1": "rgba(255, 255, 255, 0.52)",
      "glass-2": "rgba(255, 255, 255, 0.70)",
      "glass-3": "rgba(255, 255, 255, 0.88)",
      "glass-solid": "#FFFFFF",
      "glass-rim": "rgba(255, 255, 255, 0.92)",
      "glass-rim-strong": "rgba(19, 33, 62, 0.14)",
      "glass-highlight": "rgba(255, 255, 255, 0.96)",
      "glass-shadow": "rgba(30, 48, 86, 0.16)",

      "text-primary":   "#0C1526",
      "text-secondary": "rgba(20, 33, 55, 0.70)",
      "text-tertiary":  "rgba(20, 33, 55, 0.48)",
      "text-on-accent": "#FFFFFF",

      "accent":         "#2F5FD0",
      "accent-strong":  "#7A3CF0",
      "accent-soft":    "rgba(47, 95, 208, 0.10)",
      "accent-magenta": "#C2185B",
      "success":        "#15803D",
      "warning":        "#B45309",
      "danger":         "#BE123C",
      "focus":          "#2F5FD0"
    }
  },

  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "22px",
    "xl": "28px",
    "2xl": "36px",
    "pill": "999px"
  },

  "blur": {
    "thin": "14px",
    "regular": "26px",
    "thick": "40px",
    "saturate": "180%"
  },

  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },

  "type": {
    "family-arabic": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', 'Segoe UI', Tahoma, sans-serif",
    "family-latin": "'Plus Jakarta Sans', 'IBM Plex Sans Arabic', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "size": {
      "display": "clamp(2.35rem, 4.4vw, 3.9rem)",
      "title1": "clamp(1.75rem, 2.6vw, 2.5rem)",
      "title2": "clamp(1.35rem, 1.9vw, 1.85rem)",
      "title3": "1.15rem",
      "headline": "1rem",
      "body": "0.9375rem",
      "callout": "0.875rem",
      "caption": "0.75rem",
      "micro": "0.6875rem"
    },
    "leading": {
      "tight": "1.15",
      "snug": "1.35",
      "normal": "1.6",
      "arabic": "1.78"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },

  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "180ms",
      "base": "280ms",
      "slow": "420ms",
      "page": "560ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.32, 0.72, 0, 1)",
      "enter": "cubic-bezier(0.22, 1, 0.36, 1)",
      "exit": "cubic-bezier(0.55, 0, 0.75, 0.2)",
      "spring": "cubic-bezier(0.34, 1.42, 0.44, 1)",
      "spring-soft": "cubic-bezier(0.28, 1.18, 0.32, 1)"
    }
  },

  "control": {
    "height-sm": "34px",
    "height-md": "44px",
    "height-lg": "52px",
    "icon-sm": "36px",
    "icon-md": "44px",
    "icon-lg": "54px",
    "touch-target": "44px",
    "tv-target": "64px"
  },

  "elevation": {
    "1": "0 1px 2px rgba(4, 8, 20, 0.18), 0 8px 24px -12px rgba(4, 8, 20, 0.45)",
    "2": "0 2px 6px rgba(4, 8, 20, 0.20), 0 18px 44px -18px rgba(4, 8, 20, 0.60)",
    "3": "0 6px 16px rgba(4, 8, 20, 0.24), 0 32px 80px -24px rgba(4, 8, 20, 0.72)"
  }
}
