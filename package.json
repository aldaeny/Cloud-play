{
  "name": "aether",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace aether-api",
    "build": "npm run build --workspace aether-api",
    "test": "npm run test --workspace aether-api",
    "lint": "npm run lint --workspace aether-api"
  },
  "overrides": {
    "@nestjs/config": {
      "lodash": "4.18.1"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/common": {
      "file-type": "21.3.2"
    },
    "express@4.22.1": {
      "qs": "6.16.2"
    },
    "@angular-devkit/core": {
      "picomatch": "4.0.7",
      "ajv": "8.20.0"
    },
    "@nestjs/cli": {
      "glob": "10.5.0",
      "inquirer": "8.2.7",
      "webpack": "5.112.2"
    },
    "@angular-devkit/schematics-cli": {
      "inquirer": "9.3.8"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
